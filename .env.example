# Copy this file to .env and fill in your values.
# Get your free Groq API key (no credit card) at: https://console.groq.com

# Your Groq API key
GROQ_API_KEY="your-groq-api-key-here"

# Groq OpenAI-compatible base URL (do not change)
LLM_BASE_URL="https://api.groq.com/openai/v1"

# Model to use for evaluation
LLM_MODEL="llama-3.3-70b-versatile"

# Optional: Slack webhook for regression alerts
SLACK_WEBHOOK_URL=""
